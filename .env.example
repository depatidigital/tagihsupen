# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=https://tagihsupen.id
TZ=Asia/Jakarta

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tagihsupen

# IDCloudHost S3 Storage
S3_ENDPOINT=https://is3.cloudhost.id
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=depatidigital
S3_ROOT_DIR=tagihsupen
S3_PUBLIC_URL=https://is3.cloudhost.id/depatidigital/tagihsupen

# WhatsApp — semata-api HTTP gateway
# Config prioritas: tabel waConfig di DB → env fallback
WA_API_URL=https://your-semata-api-url
WA_APP_ID=your_app_id
WA_SECRET_KEY=your_secret_key
# Nomor WA operator tagihsupen (format: 628xxxxxxxxxx)
WA_CONTACT_NUMBER=628xxxxxxxxxx

# OpenAI — AI foto analysis di /lapor
OPENAI_API_KEY=sk-your_openai_key

# Admin
ADMIN_PASSWORD=your_admin_password

# Cron (node-cron, bearer token untuk endpoint /api/cron/*)
CRON_SECRET=your_cron_secret
